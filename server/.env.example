# Railway service variables for the Rails API (server/)
#
# Required:
#   DATABASE_URL          - from your Railway Postgres service (reference variable)
#   SECRET_KEY_BASE       - generate with: bundle exec rails secret
#   RAILS_ENV=production
#   FRONTEND_ORIGIN       - your Netlify site URL, e.g. https://saudirides.netlify.app
#   APP_HOST              - this API public host, e.g. your-api.up.railway.app (no https://)
#
# Optional:
#   FRONTEND_ORIGINS      - comma-separated extra origins
#   RAILS_LOG_LEVEL=info
#   RAILS_MAX_THREADS=5
#   WEB_CONCURRENCY=1
